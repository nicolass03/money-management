{
	admin off
	persist_config off
	# Railway terminates TLS at the edge, so Caddy must not manage certificates.
	auto_https off
	log {
		format json
	}
	servers {
		# Trust Railway's proxy so client IPs/headers are read correctly.
		trusted_proxies static private_ranges 100.0.0.0/8
	}
}

:{$PORT:8080} {
	log {
		format json
	}

	root * dist

	encode gzip zstd

	# Security headers applied to every response.
	header {
		X-Frame-Options "DENY"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' {$VITE_SUPABASE_URL} {$VITE_API_URL}; object-src 'none'; frame-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; upgrade-insecure-requests"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}

	# Railway health check endpoint.
	handle /health {
		respond "ok" 200
	}

	# Fingerprinted build assets: long-lived, immutable caching. No SPA fallback — a missing chunk
	# (stale tab after a deploy) must 404 so the client's `vite:preloadError` handler reloads,
	# instead of receiving index.html as JavaScript.
	handle /assets/* {
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# Serve real files, falling back to index.html for client-side routing. index.html must be
	# revalidated on every load so a deploy is picked up immediately.
	handle {
		header Cache-Control "no-cache"
		file_server
		try_files {path} /index.html
	}
}
